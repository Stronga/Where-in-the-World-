# MediaPipe graph that performs hand tracking with TensorFlow Lite on CPU.

# Input stream of images.
input_stream: "input_video"

# Output stream of detected hand landmarks.
output_stream: "multi_hand_landmarks"
# Output stream of world landmarks.
output_stream: "multi_hand_world_landmarks"
# Output stream of handedness.
output_stream: "multi_handedness"

# Throttles the images flowing downstream for flow control. It passes through
# the very first incoming image unaltered, and waits for downstream nodes
# (calculators) to finish their tasks before it passes through another image.
# All images that come in while waiting are dropped, limiting the number of
# in-flight images in most part of the graph to 1. This prevents the downstream
# nodes from being overloaded with images.
node {
  calculator: "FlowLimiterCalculator"
  input_stream: "input_video"
  input_stream_info: {
    tag_index: "0"
    back_edge: true
  }
  output_stream: "throttled_input_video"
}

# Subgraph that detects palms.
node {
  calculator: "PalmDetectionCpu"
  input_stream: "throttled_input_video"
  output_stream: "multi_palm_detections"
}

# Subgraph that localizes hand landmarks.
node {
  calculator: "HandLandmarkTrackingCpu"
  input_stream: "IMAGE:throttled_input_video"
  input_stream: "ROI:multi_palm_detections"
  output_stream: "LANDMARKS:multi_hand_landmarks"
  output_stream: "WORLD_LANDMARKS:multi_hand_world_landmarks"
  output_stream: "HANDEDNESS:multi_handedness"
}